	env.ClassicOriginalSelect = env.ClassicOriginalSelect or coins.SelectCoin
	local original = env.ClassicOriginalSelect
	coins.SelectCoin = function(coin, all)
		return original(coin, all or (env.MenuSendAll and env.ClassicMenuRun ~= nil))
	end
end)

-- IMPORTANT: the game's Network module blocks and reports (_G.Blunder) any request whose call stack contains executor
-- code. So the menu never calls game functions that talk to the server; it only changes what the game's own code reads.

-- Teleport: the game's teleport menu treats every area you've unlocked as if you bought its teleport, so the game's own
-- click code does the teleport. Locked areas stay locked.
env.MenuTeleport = env.MenuTeleport == nil and true or env.MenuTeleport
pcall(function()
	-- undo the old version's Clicked hook (it called the teleport from menu code, which the game reports)
	local tp = getsenv(LocalPlayer.PlayerScripts.Scripts.GUIs.Teleport)
	if env.ClassicOriginalClicked then tp.Clicked = env.ClassicOriginalClicked end
end)
pcall(function()
	local world = Library.WorldCmds
	env.ClassicOriginalHasTeleport = env.ClassicOriginalHasTeleport or world.HasTeleport
	local original = env.ClassicOriginalHasTeleport
	world.HasTeleport = function(area, ...)
		if env.MenuTeleport and env.ClassicMenuRun ~= nil and world.HasArea(area) then return true end
		return original(area, ...)
	end
end)
-- the "Teleport to" dropdown just moves you onto the area's teleport pad (nothing is sent to the server)
local function teleportTo(area)
	local pad = Library.WorldCmds.GetMap().Teleports:FindFirstChild(area)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (pad and hum and root) then return false, "Can't teleport there right now." end
	char:PivotTo(pad.CFrame + pad.CFrame.UpVector * (hum.HipHeight + root.Size.Y / 2))
	return true
end

-- Fast hatch: the egg animation acts as if you own "Skip Egg Open" (click to skip, and skipped by itself while
-- Auto Hatch is on). Only the animation changes; the server already picked the pets before it starts.
env.MenuFastHatch = env.MenuFastHatch == nil and true or env.MenuFastHatch
