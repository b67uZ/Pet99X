-- Low device mode: lowest quality, no shadows, no post effects, no particles; everything is put back when turned off
local lowSaved = env.ClassicLowSaved or {} -- kept across re-runs so turning it off still restores everything
env.ClassicLowSaved = lowSaved
local function lowOne(obj)
	if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire")
		or obj:IsA("Sparkles") or obj:IsA("PostEffect") then
		if obj.Enabled then
			lowSaved[obj] = { Enabled = true }
			obj.Enabled = false
		end
	elseif obj:IsA("BasePart") and (obj.Material ~= Enum.Material.SmoothPlastic or obj.Reflectance ~= 0) then
		lowSaved[obj] = { Material = obj.Material, Reflectance = obj.Reflectance }
		obj.Material, obj.Reflectance = Enum.Material.SmoothPlastic, 0
	end
end
local function setLowMode(on)
	if env.ClassicLowConn then env.ClassicLowConn:Disconnect() env.ClassicLowConn = nil end
	if on then
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		lowSaved[Lighting] = lowSaved[Lighting] or { GlobalShadows = Lighting.GlobalShadows }
		Lighting.GlobalShadows = false
		pcall(function()
			lowSaved[workspace.Terrain] = lowSaved[workspace.Terrain] or { Decoration = workspace.Terrain.Decoration }
			workspace.Terrain.Decoration = false
		end)
		for _, obj in ipairs(Lighting:GetDescendants()) do pcall(lowOne, obj) end
		for _, obj in ipairs(workspace:GetDescendants()) do pcall(lowOne, obj) end
		env.ClassicLowConn = workspace.DescendantAdded:Connect(function(obj) pcall(lowOne, obj) end)
	else
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
		for obj, props in pairs(lowSaved) do
			pcall(function()
				for k, v in pairs(props) do obj[k] = v end
			end)
		end
		table.clear(lowSaved)
	end
end

-- Hide other players' pets / other players: made invisible on your screen only, checked every second
local hidden = env.ClassicHidden or { pets = {}, players = {} }
env.ClassicHidden = hidden
local function hideModel(root, bucket)
	local function hideOne(obj)
		if obj:IsA("BasePart") or obj:IsA("Decal") then
			bucket[obj] = bucket[obj] or "Transparency"
			obj.LocalTransparencyModifier = 1
		elseif (obj:IsA("BillboardGui") or obj:IsA("ParticleEmitter") or obj:IsA("Trail")) and obj.Enabled then
			bucket[obj] = "Enabled"
			obj.Enabled = false
		end
	end
	hideOne(root)
	for _, obj in ipairs(root:GetDescendants()) do hideOne(obj) end
end
local function showBucket(bucket)
	for obj, kind in pairs(bucket) do
		pcall(function()
			if kind == "Enabled" then obj.Enabled = true else obj.LocalTransparencyModifier = 0 end
		end)
	end
	table.clear(bucket)
end
local function showHidden()
	showBucket(hidden.pets)
	showBucket(hidden.players)
end
local function petOwner(pet)
	local owner = pet:GetAttribute("Owner")
	if owner == nil and pet:FindFirstChild("Owner") then owner = pet.Owner.Value end
	return owner
end
local function isMine(owner)
	return owner == LocalPlayer or owner == LocalPlayer.Name or owner == LocalPlayer.UserId
end
local function updateHidden()
	if env.MenuHidePets then
		local pets = workspace:FindFirstChild("__THINGS") and workspace.__THINGS:FindFirstChild("Pets")
		for _, pet in ipairs(pets and pets:GetChildren() or {}) do
			local owner = petOwner(pet)
			if owner ~= nil and not isMine(owner) then hideModel(pet, hidden.pets) end
		end
	elseif next(hidden.pets) then
		showBucket(hidden.pets)
	end
	if env.MenuHidePlayers then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then hideModel(plr.Character, hidden.players) end
		end
	elseif next(hidden.players) then
		showBucket(hidden.players)
	end
end

-- start with what was on last time (when the script is run again)
if env.MenuLowMode then setLowMode(true) end
RunService:Set3dRenderingEnabled(not env.MenuNo3D)
task.spawn(function()
	while env.ClassicMenuRun == runId do
		pcall(updateHidden)
		task.wait(1)
	end
end)

-- Send to biggest / nearest coin: one press sends all your pets to one coin in the area you're standing in. It fires the
-- same local signal as your own click (the game's code then talks to the server), so nothing is sent from menu code.
local function coinPos(coin)
	local pos = coin:FindFirstChild("POS")
	return pos and pos.Position or coin:GetPivot().Position
end
local function coinsHere()
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local all = Library.Things:FindFirstChild("Coins")
	if not (root and all) then return {}, nil end
	-- the area you're in = the area of the closest coin
	local area, best = nil, math.huge
	for _, coin in ipairs(all:GetChildren()) do
		local d = (coinPos(coin) - root.Position).Magnitude
		if d < best then area, best = coin:GetAttribute("Area"), d end
	end
	local list = {}
	for _, coin in ipairs(all:GetChildren()) do
		local c = coin:FindFirstChild("Coin")
		if coin:GetAttribute("Area") == area and not (c and c:GetAttribute("PreventClick")) then list[#list + 1] = coin end
	end
	return list, area, root.Position
end
local function sendPets(mode)
	local list, area, here = coinsHere()
	if not area or not Library.WorldCmds.HasArea(area) then return false, "No unlocked coins around you." end
	local pick, score = nil, -math.huge
	for _, coin in ipairs(list) do
		local s = mode == "biggest" and (coin:GetAttribute("Health") or 0) or -(coinPos(coin) - here).Magnitude
		if s > score then pick, score = coin, s end
	end
	if not pick then return false, "No coins left in " .. area .. "." end
	Library.Signal.Fire("Group Select Coin", pick)
	return true, (pick:GetAttribute("Name") or "Coin") .. " (" .. Library.Functions.Commas(pick:GetAttribute("Health") or 0) .. " HP)"
end

-- Hatch eggs: pick an egg, the menu puts you next to it and turns on the game's own Auto Hatch (gamepass) for it.
-- The game then buys it every ~0.75 s like normal Auto Hatch; it stops by itself when you can't afford it anymore.
env.MenuEgg = env.MenuEgg or nil
local PICK_EGG = "— pick an egg —"
local function eggStands()
	local stands = {}
	local eggs = Library.WorldCmds.GetMap():FindFirstChild("Eggs")
	for _, obj in ipairs(eggs and eggs:GetDescendants() or {}) do
		local id = obj:IsA("Model") and obj:GetAttribute("ID")
		if id and Library.Directory.Eggs[id] and obj:GetAttribute("Unlocked") then stands[id] = obj end
	end
	return stands
end
local function eggList()
	local names = {}
	for id in pairs(eggStands()) do names[#names + 1] = id end
	table.sort(names, function(a, b) return Library.Directory.Eggs[a].cost < Library.Directory.Eggs[b].cost end)
	table.insert(names, 1, PICK_EGG)
	return names
end
local function ownsAutoHatch()
	local id = Library.Directory.Gamepasses["Auto Hatch"].ID
	return (env.ClassicOriginalOwns or Library.Gamepasses.Owns)(id)
end
local function stopHatching()
	Library.Variables.AutoHatchEnabled = false
	Library.Variables.AutoHatchEggId = nil
end
local function startHatching(id)
	if not ownsAutoHatch() then return false, "This account doesn't own the Auto Hatch gamepass." end
	local stand = eggStands()[id]
	if not stand then return false, id .. " isn't in this world or its area is locked." end
	-- stand a few studs in front of the egg, on the side facing its platform
	local eggPos = stand:GetPivot().Position
	local platform = stand.Parent and stand.Parent.Parent and stand.Parent.Parent:FindFirstChild("PLATFORM")
	local towards = platform and (platform:GetPivot().Position - eggPos) * Vector3.new(1, 0, 1) or Vector3.new(1, 0, 0)
	if towards.Magnitude < 0.1 then towards = Vector3.new(1, 0, 0) end
	local spot = eggPos + towards.Unit * 7
	local char = LocalPlayer.Character
	if char then char:PivotTo(CFrame.lookAt(spot, Vector3.new(eggPos.X, spot.Y, eggPos.Z))) end
	Library.Variables.AutoHatchEggId = id
	Library.Variables.AutoHatchEnabled = true
	return true
end

-- lists for the dropdowns
local function boardList()
	local names = {}
	for id in pairs(Library.Directory.Hoverboards) do names[#names + 1] = id end
	table.sort(names, function(a, b)
		local sa, sb = Library.Directory.Hoverboards[a].speed, Library.Directory.Hoverboards[b].speed
		if sa ~= sb then return sa > sb end
		return a < b
	end)
	return names
end

local PICK_AREA = "— pick an area —" -- Rayfield needs a dropdown to start with something selected
local function areaList()
	local world, names = Library.WorldCmds.Get(), {}
	for id, area in pairs(Library.Directory.Areas) do
		if area.world == world and not area.hidden and Library.WorldCmds.HasArea(id) then names[#names + 1] = id end
	end
	table.sort(names, function(a, b) return Library.Directory.Areas[a].mult < Library.Directory.Areas[b].mult end)
	table.insert(names, 1, PICK_AREA)
	return names
end

