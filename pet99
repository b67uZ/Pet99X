		if not area or area == PICK_AREA then return end
		if not Library.WorldCmds.HasArea(area) then
			Rayfield:Notify({ Title = "Teleport", Content = area .. " is still locked.", Duration = 3, Image = "lock" })
			return
		end
		local ok, err = teleportTo(area)
		if not ok then Rayfield:Notify({ Title = "Teleport", Content = err, Duration = 3, Image = "x" }) end
	end,
})
