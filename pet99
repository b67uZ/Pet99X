-- Hoverboard: puts a board in your save on your side only, then the game's own Q key / hoverboard button rides it.
-- Other players don't see it. A board you really own is never touched.
local function hoverScript()
	return getsenv(LocalPlayer.PlayerScripts.Scripts.Game.Hoverboard)
end
local function ownsBoard(s, name)
	return s.Hoverboards and (s.Hoverboards[name] or table.find(s.Hoverboards, name)) and true or false
end
local function setHoverboard(on)
	pcall(function()
		local s = Library.Save.Get()
		local current = s.EquippedHoverboard
		local fake = current ~= "" and not ownsBoard(s, current)
		if on and (current == "" or (fake and current ~= env.MenuHoverBoard)) then
			setreadonly(s, false)
			s.EquippedHoverboard = env.MenuHoverBoard
			if Library.Variables.UsingHoverboard then hoverScript().Create(LocalPlayer) end -- swap the board you're on
		elseif not on and fake then
			-- get off locally (the game's own toggle would send a request from menu code, which the game reports)
			if Library.Variables.UsingHoverboard then
				Library.Variables.UsingHoverboard = false
				hoverScript().Remove(LocalPlayer)
				hoverScript().UpdateButton()
			end
			setreadonly(s, false)
			s.EquippedHoverboard = ""
		end
	end)
end
env.ClassicMenuRun = runId

-- the features: one loop, every second
task.spawn(function()
	while env.ClassicMenuRun == runId do
		if env.MenuOrb then
			pcall(function()
				local orbs = getsenv(LocalPlayer.PlayerScripts.Scripts.Game.Orbs)
				debug.setupvalue(orbs.UpdatePickupDistance, 3, math.huge)
			end)
		end
		pcall(function()
			local s = Library.Save.Get()
			local want = env.MenuSpeed and env.PetSpeedValue or nil
			if s and s.Upgrades and s.Upgrades["Pet Walkspeed"] ~= want then
				setreadonly(s.Upgrades, false)
				s.Upgrades["Pet Walkspeed"] = want
			end
		end)
		if env.MenuHover then setHoverboard(true) end
		task.wait(1)
	end
end)

-- Send all: a quick click on a coin acts like the game's hold-click, so every pet goes to it. Only the "one pet /
-- all pets" flag is changed; the game's own scripts still send the request to the server.
env.MenuSendAll = env.MenuSendAll == nil and true or env.MenuSendAll
